{
  "name": "1key",
  "version": "0.1.0",
  "private": true,
  "description": "1key — a static Next.js games portal with a themeable UI, plus a small Node queue/presence gate service.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bash scripts/build-unified.sh",
    "build:app": "next build && cp public/_headers out/_headers && ([ ! -f public/CNAME ] || cp public/CNAME out/CNAME)",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gate": "node server/queue-gate.js"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.454.0",
    "next": "^14.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.183.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
